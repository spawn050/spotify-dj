# Client ID of your app from https://developer.spotify.com/dashboard (no secret needed: PKCE)
SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Songs kept in the queue, including the one currently playing
DJ_QUEUE_DEPTH=3
# Seconds between playback checks
DJ_POLL_SECONDS=5
